# ---- Backend ----
# Base URL where the FastAPI backend is running.
# For Hugging Face Spaces: https://<your-space>.hf.space
# For local dev: http://localhost:7860
VITE_API_BASE_URL=https://fuqi11-sat-ai-backend.hf.space

# ---- LLM Configuration (backend only) ----
# Path to the GGUF model file inside the container
MODEL_PATH=models/gemma-2-9b-it-Q4_K_M.gguf

# Llama.cpp context window size
LLM_CONTEXT_SIZE=3072

# Number of CPU threads for inference (match your vCPU count)
LLM_THREADS=2

# Inference batch size
LLM_BATCH_SIZE=256

# ---- RAG ----
# Path to the BM25 corpus JSON file
CORPUS_PATH=cloud_corpus.json

# ---- Groq (optional fast LLM path) ----
# Free tier: https://console.groq.com — no credit card required
# Add this as a Hugging Face Space secret named GROQ_API_KEY
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
